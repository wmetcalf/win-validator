# win-validator golden rotation — one gated refresh+rotate cycle (driven by the .timer).
# Rebakes the golden's trust state (disallowed kill-list / CRL cache / roots via myatg --refresh),
# validates the candidate (benign==Valid + revoked==Revoked), and promotes it ONLY if it passes,
# keeping the last N goldens as rollback backups. A failing gate keeps the current golden + exits
# non-zero (surfaced by systemd). Restarts the pool-manager on success to re-warm off the new base.
# Every GOLDEN_MAX_CHAIN cycles (and always with GOLDEN_REBAKE_FROM=master) the cycle is the FULL
# golden_build bake from the packer master: it COMPILES the agent from MYATG_SRC (below) — whatever
# that checkout holds is what ships to every worker.
[Unit]
Description=win-validator golden refresh + validation-gated rotation
After=libvirtd.service winval-pool-manager.service
Requires=libvirtd.service

[Service]
Type=oneshot
User=root
WorkingDirectory=/opt/win-validator
Environment=PYTHONPATH=/opt/win-validator
Environment=GOLDEN_MASTER=/var/lib/libvirt/images/winserver2025-core.qcow2
# the SAME name the pool-manager unit and vm_pool.py read: one path, promoted to and booted from
Environment=AUTHENTICODE_GOLDEN_BASE=/dev/shm/golden-base.qcow2
Environment=GOLDEN_BASE_DISK=/var/lib/libvirt/images/golden-base.qcow2
Environment=GOLDEN_BACKUP_DIR=/var/lib/libvirt/images/golden-backups
Environment=GOLDEN_KEEP_N=5
# The benign signed sample the rotation gate validates (benign==Valid, and revoked==Revoked when
# GOLDEN_REVOKED_SAMPLE is set): set both in /etc/winval/winval.env (see the deploy README).
# Set a known-revoked sample to also gate the disallowed/revocation path (strongly recommended):
#   GOLDEN_REVOKED_SAMPLE=/var/lib/winval/samples/revoked.dll
Environment=GOLDEN_RESTART_SERVICE=winval-pool-manager
Environment=MYATG_SRC=/opt/myatg
EnvironmentFile=-/etc/winval/winval.env
# the gate samples live under /var/lib/winval/samples (root-owned), never /tmp
PrivateTmp=true
ExecStart=/opt/win-validator/.venv/bin/python /opt/win-validator/golden_rotate.py refresh-and-rotate
