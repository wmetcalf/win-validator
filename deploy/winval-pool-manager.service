# win-validator POOL-MANAGER — the privileged dispatcher (host systemd unit).
#
# Runs on the libvirt host (it needs virsh + iptables for the VM pool + rooter egress + tunnel
# kill-switch). It is NEVER client-facing: it only claims queued jobs from the same Postgres the
# ingress container writes to, reads their spooled inputs from the shared job_root, validates them
# in a warm VM worker, and writes the verdict back. Install:
#     sudo git clone https://github.com/wmetcalf/win-validator /opt/win-validator   # ROOT-owned: this unit runs as root
#     sudo install -d -m 0700 /etc/winval && sudo test -e /etc/winval/winval.env || sudo install -m 0600 deploy/winval.env.example /etc/winval/winval.env  # ROOT-ONLY (DB password); first time only, then edit
#     sudo cp deploy/winval-pool-manager.service /etc/systemd/system/
#     sudo systemctl daemon-reload && sudo systemctl enable --now winval-pool-manager
[Unit]
Description=win-validator pool-manager (libvirt VM worker dispatcher)
# The start limit is for FAST failures — Postgres not yet accepting connections after a reboot
# (PoolManager gives up after BLASTBOX_DB_POOL_TIMEOUT, 10 s), a bad winval.env, a missing venv:
# eight starts 30 s apart cover a Postgres container that takes minutes to come up, and only a
# fault that outlives those ~4 minutes latches the unit `failed` (recover with
# `systemctl reset-failed winval-pool-manager` once fixed). A start that dies in the start budget
# (TimeoutStartSec below: up to 30 min behind a rotation's lock plus the copy) is one start per
# window and never latches: retrying a wedged store each budget is the intended behaviour, not a
# loop to cap.
StartLimitIntervalSec=10min
StartLimitBurst=8
After=network-online.target libvirtd.service docker.service
Wants=network-online.target
Requires=libvirtd.service

[Service]
Type=simple
# Needs libvirt + iptables. Run as root (simplest) or a user in the libvirt group with passwordless
# sudo for virsh/iptables — LibvirtVmConfig.sudo prefixes those, so root makes the sudo a no-op.
User=root
# The checkout (or a symlink to it) at a canonical path — nothing host-specific in this unit.
WorkingDirectory=/opt/win-validator
Environment=PYTHONPATH=/opt/win-validator
# Defaults; /etc/winval/winval.env (deploy/winval.env.example) overrides any of them and is the
# place for the Postgres password, the pool size, the ssh key, egress and smoke settings.
Environment=BLASTBOX_DATABASE_URL=postgresql://winval:winval@127.0.0.1:5433/winval
Environment=WINVAL_JOB_ROOT=/var/lib/winval/jobs
Environment=AUTHENTICODE_POOL_SIZE=2
Environment=GOLDEN_MASTER=/var/lib/libvirt/images/winserver2025-core.qcow2
Environment=AUTHENTICODE_GOLDEN_BASE=/dev/shm/golden-base.qcow2
EnvironmentFile=-/etc/winval/winval.env
# THE RAM BASE IS NOT DURABLE: /dev/shm empties on reboot. Materialise it before a start ONLY WHEN
# IT IS MISSING — a base that is present is the pool's, whoever put it there (a rotation, a hand
# bake, golden_build.py), and this unit never second-guesses it: comparing it against anything
# would replace a working golden with an older image on a plain restart.
#
# FROM THE PROMOTED GOLDEN, NOT THE PACKER MASTER. golden_rotate.rotate() promotes each gated
# candidate to GOLDEN_BASE_DISK (the durable on-disk twin) AND to the RAM base; GOLDEN_MASTER is
# the frozen rung-0 image and is never refreshed. The master is the source only when no golden
# has ever been promoted.
#
# ATOMIC: the copy lands in a temporary file and is renamed over the base (mv -T: a directory at
# the base path is a failure, never a destination) only when its size matches the source, so an
# interrupted copy (a start timeout, a reboot mid-copy) never becomes the base — the next start
# finds no base and copies again (a temporary a start-timeout kill left behind is swept first —
# only this unit's own <base>.XXXXXX files; golden_rotate's temporaries are <base>.rot.XXXXXX,
# a name the sweep never matches, so a start during a rotation cannot unlink a copy in flight). The
# source is checked BEFORE anything is written. /dev/shm is WORLD-WRITABLE (sticky), so every path this unit touches
# there is defended: the temporary is created by mktemp (O_EXCL, root-owned — never a symlink
# another local user planted for root to write through, and the sticky bit stops them replacing
# it), and a present base is refused unless it is a regular file OWNED by this unit's user.
Environment=GOLDEN_BASE_DISK=/var/lib/libvirt/images/golden-base.qcow2
# UNDER THE ROTATION LOCK (the same file golden_rotate.py takes): a start that finds no RAM base
# while a rotation is publishing one would otherwise copy the OLD source (the frozen master on a
# host with no promoted golden) over the freshly promoted base — deterministically, since the
# size check compares against the same untouched source. flock waits for the rotation to finish,
# then the present-base check sees what it published. golden_rotate releases the lock before it
# restarts this unit, so the restart cannot wait on itself.
Environment=GOLDEN_ROTATE_LOCK=/run/winval-golden-rotate.lock
# the lock must be 0600 BEFORE flock creates it (0644 under umask 022): flock(2) needs only a readable
# descriptor, so a world-readable lock lets any local user hold it and stall every rotation and start
ExecStartPre=/bin/sh -c 'umask 077; : >> "$GOLDEN_ROTATE_LOCK" && chmod 0600 "$GOLDEN_ROTATE_LOCK"'
ExecStartPre=/usr/bin/flock -w 1800 ${GOLDEN_ROTATE_LOCK} /bin/sh -c 'b="$AUTHENTICODE_GOLDEN_BASE"; if [ -L "$b" ] || [ -d "$b" ]; then echo "refusing RAM base $b: a symlink or a directory, not a regular file (/dev/shm is world-writable)" >&2; exit 1; fi; if [ -f "$b" ]; then [ "$(stat -c %%u "$b")" = "$(id -u)" ] && exit 0; echo "refusing RAM base $b: owned by uid $(stat -c %%u "$b"), not by this unit (/dev/shm is world-writable)" >&2; exit 1; fi; src="$GOLDEN_BASE_DISK"; [ -f "$src" ] || src="$GOLDEN_MASTER"; [ -f "$src" ] || { echo "no golden to materialise the RAM base from: neither $GOLDEN_BASE_DISK nor $GOLDEN_MASTER exists" >&2; exit 1; }; echo "materialising RAM base from $src"; for f in "$b".??????; do [ ! -L "$f" ] && [ -f "$f" ] && [ "$(stat -c %%u "$f")" = "$(id -u)" ] && rm -f "$f"; done; t="$(mktemp "$b.XXXXXX")" || exit 1; cp "$src" "$t" && [ "$(stat -c %%s "$t")" = "$(stat -c %%s "$src")" ] && chmod 0644 "$t" && mv -fT "$t" "$b" || { rm -f "$t"; exit 1; }'
# The start job = up to 30 min waiting for a rotation to release the lock (flock -w 1800 above)
# PLUS the copy itself (an 18 GB image at a cold cache on a slow store can take 20 min), so the
# budget is the sum: a contended start must not be killed mid-copy by its own timeout.
TimeoutStartSec=55min
# Smoke gate — OPT-IN, and OFF until you set it in winval.env: with AUTHENTICODE_SMOKE_SAMPLE set,
# a benign signed sample must validate == Valid BEFORE the clean snapshot is taken AND after every
# recycle, so a booted-but-broken golden/worker never serves a job. Without it, readiness is
# port-open only. The deploy README tells you where to put the sample; set it.
#   AUTHENTICODE_SMOKE_SAMPLE=/var/lib/winval/samples/whoami.exe
# Recycle cadence ("clear the job"): snapshot-revert wipes the per-job contamination. Default 25
# (the engine's parse-only risk×cost). Set to 1 to clear after EVERY job (max isolation, ~6-8s/job).
#   AUTHENTICODE_JOBS_PER_RECYCLE=1
ExecStart=/opt/win-validator/.venv/bin/python -m winval_blastbox.pool_manager
Restart=on-failure
RestartSec=30
# /dev/shm holds the RAM-backed golden + worker overlays; don't let systemd sandbox it away.
PrivateTmp=false

[Install]
WantedBy=multi-user.target
