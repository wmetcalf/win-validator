# win-validator runtime environment — copy to /etc/winval/winval.env and edit: the pool-manager
# unit reads it (EnvironmentFile), and it can be sourced for the build/rotate scripts.
# systemd's EnvironmentFile does NOT strip trailing `# comments` from a value — keep comments on
# their own lines, as this file does. Canonical code lives in this repo; data/secrets live OUTSIDE it.
#
#   code:    /opt/win-validator         (this repo — github.com/wmetcalf/win-validator; the unit's WorkingDirectory)
#   myatg:   ~/myatg                    (github.com/wmetcalf/myatg — compiled in-guest)
#   data:    ~/win-validator-data       (corpus / samples / keys / fakenet — NEVER committed)

# --- golden image (the disposable-worker base) -----------------------------------------------------
# baked `myatg --serve-http` golden
GOLDEN_MASTER=/var/lib/libvirt/images/winserver2025-core.qcow2
# RAM base workers overlay off (COW)
GOLDEN_BASE=/dev/shm/golden-base.qcow2
AUTHENTICODE_GOLDEN_BASE=/dev/shm/golden-base.qcow2
# key for the golden (build/admin) — host-specific
AUTHENTICODE_SSH_KEY=/etc/winval/win_golden

# --- myatg source (staged + compiled in-guest by golden_build.py) ----------------------------------
# a myatg checkout; default ../myatg
MYATG_SRC=/opt/myatg

# --- warm pool / reuse ------------------------------------------------------------------------------
AUTHENTICODE_POOL_SIZE=2
# 1 = snapshot-revert every job (max isolation)
AUTHENTICODE_JOBS_PER_RECYCLE=25

# --- warm CRL cache + boot smoke test (optional; point at benign signed samples) -------------------
# AUTHENTICODE_WARM_DIR=/var/lib/winval/corpus
# The boot/recycle smoke gate is OFF until this is set — put a benign signed sample at the path and
# set it (the deploy README's bring-up does). GOLDEN_BENIGN_SAMPLE is the rotation gate's sample.
AUTHENTICODE_SMOKE_SAMPLE=/var/lib/winval/samples/whoami.exe
GOLDEN_BENIGN_SAMPLE=/var/lib/winval/samples/whoami.exe

# --- per-job overrides, forwarded per request (client-set, gated by the orchestrator allowlist) ----
#   online|offline|none  ->  ?rev=      (verified: overrides server default)
# AUTHENTICODE_REV=online
#   ps|native            ->  ?scripts=
# AUTHENTICODE_SCRIPTS=ps
#   AUTHENTICODE_GV is server-global (baked into the golden's serve startup); TIER is not a myatg param.

# --- worker egress (rooter): direct | openvpn | wireguard | tor | inetsim ---------------------------
# AUTHENTICODE_EXIT=openvpn
# AUTHENTICODE_EGRESS_PORTS=53,80,443
# AUTHENTICODE_BLOCK_INTERNAL=true
#   pin+enforce a fixed worker IP
# AUTHENTICODE_IP_POOL=192.168.122.200-192.168.122.249

# --- job store (ingress <-> pool-manager boundary) -------------------------------------------------
# The compose publishes Postgres on 127.0.0.1:5433 (deploy/docker-compose.yml); the password is
# WINVAL_PG_PASSWORD from the compose bring-up.
# BLASTBOX_DATABASE_URL=postgresql://winval:CHANGEME@127.0.0.1:5433/winval
