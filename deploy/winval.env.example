# win-validator runtime environment — copy to /etc/winval/winval.env and edit: the pool-manager
# unit reads it (EnvironmentFile), and it can be sourced for the build/rotate scripts.
# systemd's EnvironmentFile does NOT strip trailing `# comments` from a value — keep comments on
# their own lines, as this file does. Canonical code lives in this repo; data/secrets live OUTSIDE it.
#
#   code:    /opt/win-validator         (this repo — github.com/wmetcalf/win-validator; the unit's WorkingDirectory)
#   myatg:   /opt/myatg                 (github.com/wmetcalf/myatg — compiled in-guest; the README clones it there)
#   data:    ~/win-validator-data       (corpus / samples / keys / fakenet — NEVER committed)

# --- golden image (the disposable-worker base) -----------------------------------------------------
# baked `myatg --serve-http` golden
GOLDEN_MASTER=/var/lib/libvirt/images/winserver2025-core.qcow2
# the image golden_build.py bakes the FIRST golden from (`build-and-promote`, also accepted as its
# argument); defaults to GOLDEN_MASTER — the packer's output, the only image the repo produces
#GOLDEN_BUILD_BASE=/var/lib/libvirt/images/winserver2025-core.qcow2
# RAM base workers overlay off (COW)
# the RAM base — ONE name, read by the pool (vm_pool.py), the pool-manager unit AND the rotator
# (golden_rotate.py; its old GOLDEN_BASE is only a fallback alias)
AUTHENTICODE_GOLDEN_BASE=/dev/shm/golden-base.qcow2
# key for the golden (build/admin) — host-specific
AUTHENTICODE_SSH_KEY=/etc/winval/win_golden

# --- myatg source (staged + compiled in-guest by golden_build.py) ----------------------------------
# a myatg checkout (the README bring-up clones it to /opt/myatg)
MYATG_SRC=/opt/myatg

# --- warm pool / reuse ------------------------------------------------------------------------------
AUTHENTICODE_POOL_SIZE=2
# 1 = snapshot-revert every job (max isolation)
AUTHENTICODE_JOBS_PER_RECYCLE=25
# WINVAL_JOB_RETENTION_DAYS: the pool-manager removes a job directory under WINVAL_JOB_ROOT this many days
# after it was last touched, once its row is terminal (or when no row exists at all) — nothing else sweeps
# it. 0 disables the sweep (blastbox's own convention); an unparsable value means the default, 7; below
# one day is raised to one (a running validation's scratch tree is protected only by its age).
#WINVAL_JOB_RETENTION_DAYS=7
# WINVAL_WORK_ROOT: the pool-manager's own scratch tree (0700, its uid) where samples are copied and
# validated; never under WINVAL_JOB_ROOT
#WINVAL_WORK_ROOT=/var/lib/winval/work
# AUTHENTICODE_AGENT_PORT: the port the in-guest agent listens on. golden_build.py BAKES it into the golden
# (URL ACL, firewall rule, scheduled task) and the gate and the pool poll it: change it only with a rebake.
#AUTHENTICODE_AGENT_PORT=8765

# --- warm CRL cache + boot smoke test (optional; point at benign signed samples) -------------------
# AUTHENTICODE_WARM_DIR=/var/lib/winval/corpus
# The boot/recycle smoke gate is OFF until this is set — put a benign signed sample at the path and
# set it (the deploy README's bring-up does). GOLDEN_BENIGN_SAMPLE is the rotation gate's sample.
# Set these ONLY after the sample is in place: a set AUTHENTICODE_WARM_DIR or AUTHENTICODE_SMOKE_SAMPLE
# that does not exist fails the pool-manager at start (by name) rather than failing every worker closed;
# GOLDEN_BENIGN_SAMPLE is read by the rotation, whose preflight refuses by name before any build.
# AUTHENTICODE_SMOKE_SAMPLE=/var/lib/winval/samples/whoami.exe
# AUTHENTICODE_SMOKE_EXPECT is the status the smoke sample must validate to (default Valid): a benign SIGNED sample belongs
# here, never the revoked one below — a mispairing fails every worker closed with only 'no worker became warm'.
# AUTHENTICODE_SMOKE_EXPECT=Valid
# GOLDEN_BENIGN_SAMPLE=/var/lib/winval/samples/whoami.exe
# Optional second gate sample: a binary whose signer certificate is known REVOKED; when set, the gate also asserts
# status==Revoked on it (an unset value skips that half; a set-but-missing file is refused by name before any build).
# GOLDEN_REVOKED_SAMPLE=/var/lib/winval/samples/revoked-signer.exe

# --- myatg parameters: OPERATOR-WIDE, read from the engine process's environment (this file) -------
#   No tier forwards per-job parameters: /scan takes the file only, and a ?rev= or form field on the
#   request is ignored. One value here applies to every verdict, sent to the agent as ?rev=/?scripts=.
#   online|offline|none  ->  ?rev=
# AUTHENTICODE_REV=online
#   ps|native            ->  ?scripts=
# AUTHENTICODE_SCRIPTS=ps
#   AUTHENTICODE_GV and AUTHENTICODE_TIER are read by nothing (the graveyard is GOLDEN_GRAVEYARD, baked into
#   the golden's serve startup; TIER is not a myatg parameter): exporting either only puts a
#   param_not_forwarded warning on every verdict.

# --- worker egress (rooter): direct | openvpn | wireguard | tor | inetsim ---------------------------
# the rotation preflight and the pool-manager refuse a posture the rooter would refuse at spawn, before any build:
#   inetsim needs AUTHENTICODE_FAKENET_ADDR (the FakeNet sink's address); openvpn and wireguard in shared-router mode need
#   BOTH AUTHENTICODE_GATEWAY and AUTHENTICODE_LEG (the router's address and the worker-side leg); tor has no router mode —
#   it exits via this host's tor daemon and ignores gateway/leg
# REQUIRED: the pool-manager refuses to start without it. direct is the minimum (per-worker chains, no tunnel); none is the
# explicit opt-out (no egress policy at all, the libvirt network's plain NAT — say so on purpose, never by omission)
AUTHENTICODE_EXIT=direct
# with more than one worker the start also needs AUTHENTICODE_BLOCK_INTERNAL=1 (or AUTHENTICODE_EGRESS_PORTS, or AUTHENTICODE_EXIT=drop) and
# net.bridge.bridge-nf-call-iptables=1 on the host, or the pool-manager refuses by name (a worker could reach its siblings)
# the golden's agent-port firewall rule admits one caller, the host's address on the workers' libvirt network, learned at
# bake time; set these only when the bake cannot learn it (a rebake applies a change):
# AUTHENTICODE_AGENT_CALLER=192.168.122.1
# AUTHENTICODE_LIBVIRT_NETWORK=default
# AUTHENTICODE_FAKENET_ADDR=
# AUTHENTICODE_GATEWAY=
# AUTHENTICODE_LEG=
# AUTHENTICODE_EGRESS_PORTS=53,80,443
# ON in the shipped example: with AUTHENTICODE_POOL_SIZE=2 the pool-manager refuses to start without it (or a port allowlist, or the drop exit).
# (never a trailing comment on a value line: systemd keeps it as part of the value)
AUTHENTICODE_BLOCK_INTERNAL=true
#   pin+enforce a fixed worker IP
# AUTHENTICODE_IP_POOL=192.168.122.200-192.168.122.249

# --- job store (ingress <-> pool-manager boundary) -------------------------------------------------
# The compose publishes Postgres on 127.0.0.1:5433 (deploy/docker-compose.yml); the password is
# WINVAL_PG_PASSWORD from the compose bring-up.
# BLASTBOX_DATABASE_URL=postgresql://winval:CHANGEME@127.0.0.1:5433/winval

# --- after a promotion -----------------------------------------------------------------------
# the unit to restart so warm workers pick up the promoted golden (empty = do not restart)
GOLDEN_RESTART_SERVICE=winval-pool-manager

# --- golden lifecycle paths (the rotate + pool-manager units default to these; a hand-run
# golden_rotate.py / golden_build.py reads THIS file, so keep every override here, never only in a unit)
#GOLDEN_BASE_DISK=/var/lib/libvirt/images/golden-base.qcow2
#GOLDEN_BACKUP_DIR=/var/lib/libvirt/images/golden-backups
# GOLDEN_KEEP_N: rollback backups kept in GOLDEN_BACKUP_DIR (each golden-sized); 0 = keep none. A promotion that
# published the disk twin, failed the RAM rename AND whose automatic rollback failed too leaves <backup>.keep beside its backup (or beside
# GOLDEN_CHAIN_MIRROR when the images store refused the write): that backup is held out of every prune until you
# remove the sidecar — the rotation log names both. A <backup>.keep.build-<pid>.<start> is a running build's hold on the
# retained backup it bakes from: honoured while that builder runs, removed by the next prune once it is gone
#GOLDEN_KEEP_N=5
# GOLDEN_CANDIDATE_KEEP_DAYS: days a candidate kept for a retry (NothingPublished) stays before the prune reclaims it (default 7)
# GOLDEN_STRANDED_SOURCE_HOURS: hours after which a rebake-source copy with no LIVE builder is reclaimed (default 24; the
#   preflight's space check counts it until then — the log names the copy)
# GOLDEN_CONVERT_TIMEOUT_S: seconds for the flatten (qemu-img convert) of a candidate (default 3600)
# GOLDEN_PREFLIGHT_LOCK_WAIT_S: seconds the preflight waits for the rotation lock behind a pool-manager start (default 1800)
#GOLDEN_CANDIDATE_KEEP_DAYS=7
#GOLDEN_STRANDED_SOURCE_HOURS=24
#GOLDEN_CONVERT_TIMEOUT_S=3600
#GOLDEN_PREFLIGHT_LOCK_WAIT_S=1800
# GOLDEN_WARM_DIR (below) has the same shape rule as GOLDEN_GRAVEYARD: an absolute drive path whose own characters include
# no $ ` or quote — and, like every backslash path in THIS file, written single-quoted so the loader keeps the backslashes
# GOLDEN_GRAVEYARD: the cert graveyard CSV the agent reads (default C:\certgraveyard\cert_graveyard_database.csv). Its DIRECTORY
# is granted to the agent by golden_build, so it must be an absolute drive path inside a directory whose own characters include
# no $ ` or quote (the VALUE in this file is single-quoted, as the block below says: that is how the backslashes survive)
# (UNC, forward-slash and relative paths are refused by the preflight and the build); empty disables the graveyard
#GOLDEN_ROTATE_LOCK=/run/winval-golden-rotate.lock
# GOLDEN_REBAKE_FROM: golden (default — the promoted golden, a private copy of it) | master (the FULL golden_build
# bake from the packer master every cycle: it compiles the agent from MYATG_SRC, which the timer unit pins to /opt/myatg)
#GOLDEN_REBAKE_FROM=golden
# GOLDEN_MAX_CHAIN: golden-based rebakes before one starts from the master again (the in-guest refresh only
# ever ADDS to the Disallowed store, so a withdrawn kill-list entry would otherwise persist forever)
#GOLDEN_MAX_CHAIN=4
# GOLDEN_CHAIN_MIRROR: a second copy of the chain-depth record off the images store (root filesystem), read
# when the record beside the golden could not be written; the preflight warns every run it is unwritable
#GOLDEN_CHAIN_MIRROR=/var/lib/winval/golden-base.chain
# AUTHENTICODE_MAX_UPLOAD_MB: the upload bound, enforced by the ingress container AND by the host pool-manager on
# the spooled input it copies — set it here AND in /etc/winval/compose.env as WINVAL_UPLOAD_MB (the compose reads that,
# default 1024) together with WINVAL_SPOOL_SIZE (the ingress spool tmpfs, default 2g: keep it >= 2x the cap)
#AUTHENTICODE_MAX_UPLOAD_MB=1024
# WINVAL_CLAIM_POLL_S: seconds between the pool-manager's claim polls when the queue is empty (default 0.5, floor 0.05)
#WINVAL_CLAIM_POLL_S=0.5
# WINVAL_AGENT_RESPONSE_MB: the largest verdict the host accepts from the guest agent (a verdict is stored
# twice per job; a VM answering with gigabytes would fill the host). Default 64.
#WINVAL_AGENT_RESPONSE_MB=64
# GOLDEN_WARM_DIR: a GUEST directory (e.g. 'C:\corpus' — SINGLE-QUOTED: systemd drops the backslashes of an
# unquoted value, and so does the hand-run loader) of signed binaries the rebake warms the CRL/OCSP cache with
# (myatg --warm-cache inside the guest). Distinct from AUTHENTICODE_WARM_DIR, which is a HOST corpus the pool posts
# to the agent per worker; the two are different filesystems.
#GOLDEN_WARM_DIR='C:\corpus'
# GOLDEN_GRAVEYARD: the guest path of the cert-graveyard CSV myatg --refresh reads (single-quoted, as above)
#GOLDEN_GRAVEYARD='C:\certgraveyard\cert_graveyard_database.csv'

# The single-host orchestrator (serve.py, not the deploy's two tiers) warms its VM pool at startup; ORCHESTRATOR_WARM=false skips
# that (a dev box without libvirt). Strict boolean: a typo refuses the start rather than silently skipping the warm-up.
# ORCHESTRATOR_WARM=true

# After a promotion the rotation restarts the pool-manager and then watches it for GOLDEN_RESTART_SETTLE_S seconds (default 90;
# 0 skips the watch): a start that fails seconds after systemctl returned (the unit is 'active' at once) shows as an auto-restart
# or a 'failed' unit within the window, and the rotation exits non-zero with the golden promoted but the pool down.
# GOLDEN_RESTART_SETTLE_S=90
