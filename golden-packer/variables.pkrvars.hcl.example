# Optional: copy to variables.auto.pkrvars.hcl to persist settings (Packer auto-loads *.auto.pkrvars.hcl).
# NOT settable here: iso_path, admin_password, ssh_key_file and qemu_binary — build.sh passes each as
# -var on every run (command-line vars outrank an auto var file). Use ISO_PATH, ADMIN_PASSWORD (else the
# random one in keys/admin_password.txt) and QEMU_BINARY in the environment instead.
# iso_path     = "iso/windows.iso"   # INERT here: set ISO_PATH (build.sh -var wins)
# iso_checksum = "sha256:<hex>"      # optional integrity check; "none" (default) skips it
# admin_password = "Set#Me!2026"     # INERT here: build.sh always passes -var admin_password (ADMIN_PASSWORD env,
                                     # else a strong random one saved to keys/admin_password.txt)
disk_size_mb   = 81920               # 80 GB — the template's default; RAISE, never lower (WS2025 + a cumulative + WinSxS servicing needs it)
memory_mb      = 8192                # the template's default; update finalization (TrustedInstaller) is slow on less
cpus           = 4                   # the template's default; fewer cores and the cumulative does not finalize inside WU's window
# headless     = false               # uncomment to watch the install in a QEMU window
